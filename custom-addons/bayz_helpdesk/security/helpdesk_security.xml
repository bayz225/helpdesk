<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- =====================================================
             GROUPES UTILISATEURS
             ===================================================== -->

        <!-- Utilisateur HelpDesk standard -->
        <record id="group_helpdesk_user" model="res.groups">
            <field name="name">HelpDesk : Utilisateur</field>
            <field name="implied_ids"
                   eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Technicien -->
        <record id="group_helpdesk_technician" model="res.groups">
            <field name="name">HelpDesk : Technicien</field>
            <field name="implied_ids"
                   eval="[(4, ref('bayz_helpdesk.group_helpdesk_user'))]"/>
        </record>

        <!-- Responsable -->
        <record id="group_helpdesk_manager" model="res.groups">
            <field name="name">HelpDesk : Responsable</field>
            <field name="implied_ids"
                   eval="[(4, ref('bayz_helpdesk.group_helpdesk_technician'))]"/>
        </record>


        <!-- =====================================================
             RÈGLES D'ACCÈS AUX TICKETS
             ===================================================== -->

        <!-- Utilisateur HelpDesk :
             voit uniquement les tickets dont il est demandeur -->
        <record id="rule_helpdesk_ticket_user" model="ir.rule">
            <field name="name">
                HelpDesk : Tickets de l'utilisateur
            </field>
            <field name="model_id" ref="model_helpdesk_ticket"/>
            <field name="groups"
                   eval="[(4, ref('bayz_helpdesk.group_helpdesk_user'))]"/>
            <field name="domain_force">
                [('requester_id', '=', user.id)]
            </field>
        </record>

        <!-- Technicien :
             voit ses tickets affectés ou ses tickets demandés -->
        <record id="rule_helpdesk_ticket_technician" model="ir.rule">
            <field name="name">
                HelpDesk : Tickets du technicien
            </field>
            <field name="model_id" ref="model_helpdesk_ticket"/>
            <field name="groups"
                   eval="[(4, ref('bayz_helpdesk.group_helpdesk_technician'))]"/>
            <field name="domain_force">
                ['|',
                    ('technician_id', '=', user.id),
                    ('requester_id', '=', user.id)
                ]
            </field>
        </record>

        <!-- Responsable :
             voit tous les tickets -->
        <record id="rule_helpdesk_ticket_manager" model="ir.rule">
            <field name="name">
                HelpDesk : Tous les tickets du responsable
            </field>
            <field name="model_id" ref="model_helpdesk_ticket"/>
            <field name="groups"
                   eval="[(4, ref('bayz_helpdesk.group_helpdesk_manager'))]"/>
            <field name="domain_force">
                [(1, '=', 1)]
            </field>
        </record>

        <!-- =====================================================
             RÈGLES D'ACCÈS AUX TIMESHEETS
             ===================================================== -->

        <!-- Utilisateur HelpDesk :
             voit uniquement le temps des tickets dont il est demandeur -->
        <record id="rule_helpdesk_timesheet_user" model="ir.rule">
            <field name="name">
                HelpDesk : Temps des tickets de l'utilisateur
            </field>
            <field name="model_id" ref="model_helpdesk_timesheet"/>
            <field name="groups"
                eval="[(4, ref('bayz_helpdesk.group_helpdesk_user'))]"/>
            <field name="domain_force">
                [('ticket_id.requester_id', '=', user.id)]
            </field>
        </record>

        <!-- Technicien :
             voit le temps de ses tickets affectés ou ses tickets demandés -->
        <record id="rule_helpdesk_timesheet_technician" model="ir.rule">
            <field name="name">
                HelpDesk : Temps des tickets du technicien
            </field>
            <field name="model_id" ref="model_helpdesk_timesheet"/>
            <field name="groups"
                eval="[(4, ref('bayz_helpdesk.group_helpdesk_technician'))]"/>
            <field name="domain_force">
                ['|',
                    ('ticket_id.technician_id', '=', user.id),
                    ('ticket_id.requester_id', '=', user.id)
                ]
            </field>
        </record>

        <!-- Responsable :
             voit le temps tous les tickets -->
        <record id="rule_helpdesk_timesheet_manager" model="ir.rule">
            <field name="name">
                HelpDesk : Tous les temps du responsable
            </field>
            <field name="model_id" ref="model_helpdesk_timesheet"/>
            <field name="groups"
                eval="[(4, ref('bayz_helpdesk.group_helpdesk_manager'))]"/>
            <field name="domain_force">
                [(1, '=', 1)]
            </field>
        </record>
        
    </data>
</odoo>