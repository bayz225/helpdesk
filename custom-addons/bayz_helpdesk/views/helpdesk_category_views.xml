<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- =====================================================
             VUE LISTE
             ===================================================== -->

        <record id="view_helpdesk_category_list" model="ir.ui.view">
            <field name="name">helpdesk.category.list</field>
            <field name="model">helpdesk.category</field>

            <field name="arch" type="xml">
                <list
                    decoration-muted="not active"
                    sample="1" 
                    default_order="create_date desc" 
                    limit="10"
                >
                    <field name="name"/>
                    <field 
                        name="active" 
                        widget="boolean_toggle"
                        groups="bayz_helpdesk.group_helpdesk_manager"
                    />
                    <field name="count_tickets"/>
                </list>
            </field>
        </record>

        <!-- =====================================================
             VUE FORMULAIRE
             ===================================================== -->

        <record id="view_helpdesk_category_form" model="ir.ui.view">
            <field name="name">helpdesk.category.form</field>
            <field name="model">helpdesk.category</field>

            <field name="arch" type="xml">
                <form>
                    <field name="is_manager" invisible="1"/>
                    <sheet>
                        <group>
                            <group>
                                <field
                                    name="name"
                                    readonly="not is_manager"
                                />
                                <field 
                                    name="active" 
                                    widget="boolean_toggle"
                                    groups="bayz_helpdesk.group_helpdesk_manager"
                                />
                            </group>
                        </group>

                        <notebook>
                            <page
                                string="Tickets associés"
                                name="tickets"
                            >
                                <field 
                                    name="ticket_ids"
                                >
                                    <list 
                                        create="false" 
                                        delete="false" 
                                        edit="false"
                                    >
                                        <field name="name"/>
                                        <field name="technician_id"/>
                                        <field name="priority" widget="priority"/>

                                        <field
                                            name="state"
                                            widget="badge"
                                            decoration-info="state == 'in_progress'"
                                            decoration-warning="state in ['assigned', 'pending']"
                                            decoration-danger="state == 'cancelled'"
                                            decoration-success="state == 'resolved'"
                                        />
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- =====================================================
             ACTION
             ===================================================== -->

        <record id="action_helpdesk_category" model="ir.actions.act_window">
            <field name="name">Categories</field>
            <field name="res_model">helpdesk.category</field>
            <field name="view_mode">list,form</field>

            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Créez votre première catégorie HelpDesk !
                </p>
            </field>
        </record>

        <!-- =====================================================
             MENUS
             ===================================================== -->

        <menuitem
            id="menu_category"
            name="Catégories"
            parent="menu_parameter_master"
            action="action_helpdesk_category"
            sequence="10"
        />
    </data>
</odoo>
