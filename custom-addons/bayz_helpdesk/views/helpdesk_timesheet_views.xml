<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
    
        <!-- =====================================================
             VUE PIVOT
             ===================================================== -->
    
        <record id="view_helpdesk_timesheet_pivot" model="ir.ui.view">
            <field name="name">helpdesk.timesheet.pivot</field>
            <field name="model">helpdesk.timesheet</field>

            <field name="arch" type="xml">
                <pivot string="Analyse du temps">
                    <field name="technician_id" type="row"/>
                    <field name="category_id" type="col"/>
                    <field name="duration" type="measure"/>
                </pivot>
            </field>
        </record>

        <!-- =====================================================
             VUE GRAPH
             ===================================================== -->

        <record id="view_helpdesk_timesheet_graph" model="ir.ui.view">
            <field name="name">helpdesk.timesheet.graph</field>
            <field name="model">helpdesk.timesheet</field>

            <field name="arch" type="xml">
                <graph string="Temps passé par technicien" type="bar">
                    <field name="technician_id"/>
                    <field name="category_id"/>
                    <field name="duration" type="measure"/>
                </graph>
            </field>
        </record>


        <!-- =====================================================
             VUE SEARCH
             ===================================================== -->

        <record id="view_helpdesk_timesheet_search" model="ir.ui.view">
            <field name="name">helpdesk.timesheet.search</field>
            <field name="model">helpdesk.timesheet</field>

            <field name="arch" type="xml">
                <search string="Analyse du temps">
                    <!-- Champs de recherche -->
                    <field name="ticket_id"/>
                    <field name="technician_id"/>
                    <field name="category_id"/>

                    <filter
                        name="start_datetime"
                        string="Date de travail"
                        date="start_datetime"
                    />

                    <separator/>

                    <!-- Regroupements -->
                    <group>

                        <filter
                            name="group_by_technician"
                            string="Technicien"
                            context="{'group_by': 'technician_id'}"
                        />

                        <filter
                            name="group_by_category"
                            string="Catégorie"
                            context="{'group_by': 'category_id'}"
                        />

                        <filter
                            name="group_by_ticket"
                            string="Ticket"
                            context="{'group_by': 'ticket_id'}"
                        />

                        <filter
                            name="group_by_month"
                            string="Mois"
                            context="{'group_by': 'start_datetime:month'}"
                        />

                    </group>
                </search>
            </field>
        </record>

        <!-- =====================================================
             ACTION
             ===================================================== -->
        
        <record id="action_helpdesk_time_analysis" model="ir.actions.act_window">
            <field name="name">Analyse du temps</field>
            <field name="res_model">helpdesk.timesheet</field>
            <field name="view_mode">pivot,graph</field>
            <field name="search_view_id" ref="view_helpdesk_timesheet_search"/>
        </record>

        <menuitem
            id="menu_helpdesk_time_analysis"
            name="Analyse du temps"
            action="action_helpdesk_time_analysis"
            parent="menu_helpdesk_reporting_master"
            sequence="10"
            groups="bayz_helpdesk.group_helpdesk_manager"
            />
    </data>
    
</odoo>
