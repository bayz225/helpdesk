<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- =====================================================
             VUE LISTE
             ===================================================== -->

        <record id="view_helpdesk_ticket_list" model="ir.ui.view">
            <field name="name">helpdesk.ticket.list</field>
            <field name="model">helpdesk.ticket</field>

            <field name="arch" type="xml">
                <list
                    decoration-muted="state == 'cancelled'"
                    decoration-success="state == 'resolved'"
                    sample="1"
                    limit="10"
                >
                    <field name="name"/>
                    <field name="requester_id"/>
                    <field name="technician_id"/>
                    <field 
                        name="priority" 
                        widget="priority"
                    />

                    <field
                        name="state"
                        widget="badge"
                        decoration-info="state == 'in_progress'"
                        decoration-warning="state in ['assigned', 'pending']"
                        decoration-danger="state == 'cancelled'"
                        decoration-success="state == 'resolved'"
                    />

                    <field name="is_overdue" invisible="1"/>
                    <field 
                        name="deadline"
                        decoration-danger="is_overdue"
                    />

                    <field
                        name="total_time"
                        widget="float_time"
                        sum="Total heures"
                    />
                </list>
            </field>
        </record>


        <!-- =====================================================
             VUE KANBAN
             ===================================================== -->

        <record id="view_helpdesk_ticket_kanban" model="ir.ui.view">
            <field name="name">helpdesk.ticket.kanban</field>
            <field name="model">helpdesk.ticket</field>

            <field name="arch" type="xml">
                <kanban
                    default_group_by="state"
                    js_class="helpdesk_kanban"
                    records_draggable="true"
                    quick_create="false"
                >
                    <field name="name"/>
                    <field name="reference"/>
                    <field name="requester_id"/>
                    <field name="technician_id"/>
                    <field name="is_overdue" invisible="1"/>
                    <field name="deadline"/>
                    <field name="priority"/>
                    <field name="state"/>
                    <field name="total_time"/>

                    <templates>
                        <t t-name="card">
                            <div t-attf-class="border-start border-4 ps-3 #{
                                record.priority.raw_value == '3' ? 'border-danger' :
                                record.priority.raw_value == '2' ? 'border-warning' :
                                record.priority.raw_value == '1' ? 'border-primary' :
                                'border-secondary'}">

                                <!-- En-tête : référence + priorité -->
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="small fw-bold text-muted text-uppercase">
                                        <field name="reference"/>
                                    </span>
                                    <field name="priority" widget="priority"/>
                                </div>

                                <!-- Titre -->
                                <div class="fw-bold fs-5 mt-1 lh-sm">
                                    <field name="name"/>
                                </div>

                                <!-- Demandeur -->
                                <div class="small text-muted mt-2">
                                    <i class="fa fa-user-o me-1" title="Demandeur"/>
                                    <field name="requester_id"/>
                                </div>

                                <!-- Pied : pastilles + avatar du technicien -->
                                <div class="d-flex justify-content-between align-items-center border-top pt-2 mt-3">
                                    <div class="d-flex flex-wrap gap-2">
                                        <span class="d-flex align-items-center badge rounded-pill text-bg-light border">
                                            <i class="fa fa-hourglass-half me-1" title="Temps total"/>
                                            <field name="total_time" widget="float_time"/>
                                        </span>
                                        <span t-attf-class="badge rounded-pill border #{record.is_overdue.raw_value ? 'text-bg-danger' : 'text-bg-light'}">
                                            <i class="fa fa-calendar-o me-1"  title="Échéance"/>
                                            <field name="deadline"/>
                                        </span>
                                    </div>

                                    <field name="technician_id" widget="many2one_avatar_user"/>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>


        <!-- =====================================================
             VUE FORMULAIRE
             ===================================================== -->

        <record id="view_helpdesk_ticket_form" model="ir.ui.view">
            <field name="name">helpdesk.ticket.form</field>
            <field name="model">helpdesk.ticket</field>

            <field name="arch" type="xml">
                <form>
                    <!-- Champ technique -->
                    <field
                        name="technician_domain_ids"
                        invisible="1"
                    />
                    <field
                        name="is_requester"
                        invisible="1"
                    />
                    <field 
                        name="is_assigned_technician" 
                        invisible="1"
                        />
                    <field 
                        name="is_manager" 
                        invisible="1"
                    />

                    <header>
                        <button
                            name="action_assign"
                            string="Assigner"
                            type="object"
                            invisible="state not in ['new', 'reopened']"
                            groups="bayz_helpdesk.group_helpdesk_manager"
                        />

                        <button
                            name="action_start"
                            string="Démarrer"
                            type="object"
                            invisible="state != 'assigned' or (not is_manager and not is_assigned_technician)"
                        />

                        <button
                            name="action_pending"
                            string="Mettre en attente"
                            type="object"
                            invisible="state != 'in_progress' or (not is_manager and not is_assigned_technician)"
                        />

                        <button
                            name="action_resume"
                            string="Reprendre"
                            type="object"
                            invisible="state != 'pending' or (not is_manager and not is_assigned_technician)"
                        />

                        <button
                            name="action_resolve"
                            string="Résoudre"
                            type="object"
                            invisible="state not in ['in_progress', 'pending'] or (not is_manager and not is_assigned_technician)"
                        />

                        <button
                            name="action_close"
                            string="Fermer"
                            type="object"
                            invisible="state != 'resolved'"
                            groups="bayz_helpdesk.group_helpdesk_manager"
                        />

                        <button
                            name="action_reopen"
                            string="Rouvrir"
                            type="object"
                            invisible="state not in ['resolved', 'closed']"
                            groups="bayz_helpdesk.group_helpdesk_manager"
                        />

                        <button
                            name="action_cancel"
                            string="Annuler"
                            type="object"
                            invisible="state not in ['new', 'assigned']"
                            groups="bayz_helpdesk.group_helpdesk_manager"
                        />

                        <field
                            name="state"
                            widget="statusbar"
                            statusbar_visible="new,assigned,in_progress,pending,resolved,closed,reopened,cancelled"
                        />
                    </header>

                    <sheet>
                        <div class="oe_title mb-4">
                            <h4>
                                <field name="reference" readonly="1"/>
                            </h4>

                            <h1>
                                <field
                                    name="name"
                                    placeholder="Titre du ticket..."
                                    readonly="(not is_manager and not is_requester) or state in ['assigned', 'in_progress', 'resolved', 'closed', 'cancelled']"
                                />
                            </h1>
                        </div>

                        <group>
                            <group>
                                <field
                                    name="requester_id"
                                    readonly="1"
                                />

                                <field
                                    name="technician_id"
                                    domain="[('id', 'in', technician_domain_ids)]"
                                    readonly="not is_manager or state in ['assigned', 'in_progress', 'resolved', 'closed', 'cancelled']"
                                />

                                <field
                                    name="category_id"
                                    readonly="(not is_manager and not is_requester) or state in ['assigned', 'in_progress', 'resolved', 'closed', 'cancelled']"
                                />
                            </group>

                            <group>
                                <field
                                    name="priority"
                                    widget="priority"
                                    readonly="not is_manager or state in ['in_progress', 'resolved', 'closed', 'cancelled']"
                                />

                                <field
                                    name="deadline"
                                    readonly="1"
                                />

                            </group>
                        </group>

                        <notebook>
                            <page
                                string="Description"
                                name="description"
                            >
                                <field
                                    name="description"
                                    readonly="(not is_manager and not is_requester) or state in ['assigned', 'in_progress', 'resolved', 'closed', 'cancelled']"
                                />
                            </page>

                            <page
                                string="Feuilles de temps"
                                name="timesheets"
                            >
                                <field
                                    name="timesheet_ids"
                                >
                                    <list>
                                        <field name="technician_id"/>
                                        <field name="start_datetime"/>
                                        <field name="end_datetime"/>
                                        <field name="duration" 
                                            widget="float_time" sum="Total"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>

                    <chatter>
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </chatter>
                </form>
            </field>
        </record>


        <!-- =====================================================
             VUE DE RECHERCHE
             ===================================================== -->

        <record id="view_helpdesk_ticket_search" model="ir.ui.view">
            <field name="name">helpdesk.ticket.search</field>
            <field name="model">helpdesk.ticket</field>

            <field name="arch" type="xml">
                <search string="Recherche Tickets">
                    <field name="name"/>
                    <field name="requester_id"/>
                    <field name="technician_id"/>
                    <field name="category_id"/>
                    <field name="state"/>
                    <field name="priority"/>

                    <separator/>

                    <filter
                        name="my_tickets"
                        string="Mes tickets"
                        domain="[('requester_id', '=', uid)]"
                    />

                    <filter
                        name="unassigned"
                        string="Non assignés"
                        domain="[('technician_id', '=', False)]"
                    />

                    <filter
                        name="in_progress"
                        string="En cours"
                        domain="[('state', '=', 'in_progress')]"
                    />

                    <filter
                        name="deadline_expired"
                        string="Délai passé"
                        domain="[('is_overdue', '=', True)]"
                    />

                    <separator/>

                    <group>
                        <filter
                                name="group_by_technician"
                                string="Technicien"
                                context="{'group_by': 'technician_id'}"
                            />
                        
                        <filter
                            name="group_by_category"
                            string="Catégorie"
                            context="{'group_by': 'category_id'}"
                        />

                        <filter
                            name="group_by_state"
                            string="État"
                            context="{'group_by': 'state'}"
                        />

                        <filter
                            name="group_by_priority"
                            string="Priorité"
                            context="{'group_by': 'priority'}"
                        />

                        <filter
                                name="group_by_month"
                                string="Mois"
                                context="{'group_by': 'create_date:month'}"
                            />
                    </group>

                </search>
            </field>
        </record>


        <!-- =====================================================
             ACTION
             ===================================================== -->

        <record id="action_helpdesk_ticket" model="ir.actions.act_window">
            <field name="name">Tous les tickets</field>
            <field name="res_model">helpdesk.ticket</field>
            <field name="view_mode">list,kanban,form</field>
            <field name="group_ids" eval="[
                Command.link(ref('bayz_helpdesk.group_helpdesk_manager')),
            ]"/>

            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Créez votre premier ticket HelpDesk !
                </p>
            </field>
        </record>

        <record id="action_helpdesk_ticket_technician" model="ir.actions.act_window">
            <field name="name">Tickets Assignés</field>
            <field name="res_model">helpdesk.ticket</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="group_ids" eval="[
                Command.link(ref('bayz_helpdesk.group_helpdesk_technician')),
            ]"/>
            <field name="domain">[('technician_id', '=', uid)]</field>
        </record>

        <!-- Pour les autres utilisateurs : liste et formulaire seulement -->
        <record id="action_helpdesk_ticket_requester" model="ir.actions.act_window">
            <field name="name">Mes tickets</field>
            <field name="res_model">helpdesk.ticket</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('requester_id', '=', uid)]</field>
            <field name="group_ids" eval="[
                Command.link(ref('bayz_helpdesk.group_helpdesk_user'))
            ]"/>
        </record>


        <!-- =====================================================
             MENUS
             ===================================================== -->

        <menuitem
            id="menu_helpdesk_ticket_manager"
            name="Tous les tickets"
            parent="menu_helpdesk_ticket_master"
            action="action_helpdesk_ticket"
            sequence="10"
            groups="bayz_helpdesk.group_helpdesk_manager"
        />

        <menuitem
            id="menu_helpdesk_ticket_technician"
            name="Tickets Assignés"
            parent="menu_helpdesk_ticket_master"
            action="action_helpdesk_ticket_technician"
            sequence="11"
            groups="bayz_helpdesk.group_helpdesk_technician"
        />

        <menuitem
            id="menu_helpdesk_ticket_requester"
            name="Mes tickets"
            parent="menu_helpdesk_ticket_master"
            action="action_helpdesk_ticket_requester"
            groups="bayz_helpdesk.group_helpdesk_user"
            sequence="12"
        />

    </data>
</odoo>